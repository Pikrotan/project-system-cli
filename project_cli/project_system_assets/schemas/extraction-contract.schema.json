{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extraction Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "project_id", "contract_id", "representation_id", "presented_segment_ids", "allowed_kinds", "coverage", "canonical_authority"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "profile": {"const": "project-system-extraction-contract-v1"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "contract_id": {"type": "string", "pattern": "^XCON-[0-9a-f]{32}$"},
    "representation_id": {"type": "string", "pattern": "^REP-[0-9a-f]{32}$"},
    "presented_segment_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "pattern": "^SEG-[0-9a-f]{32}$"}},
    "allowed_kinds": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["requirement", "decision", "risk", "question"]}},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presented_segments", "representation_segments", "complete"],
      "properties": {
        "presented_segments": {"type": "integer", "minimum": 1, "maximum": 10000},
        "representation_segments": {"type": "integer", "minimum": 1, "maximum": 100000},
        "complete": {"type": "boolean"}
      }
    },
    "canonical_authority": {"const": false}
  }
}
