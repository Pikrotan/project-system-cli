{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extraction Submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "proposals"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "profile": {"const": "project-system-extraction-submission-v1"},
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "statement", "support", "evidence_segment_ids"],
        "properties": {
          "kind": {"enum": ["requirement", "decision", "risk", "question"]},
          "statement": {"type": "string", "minLength": 1},
          "support": {"enum": ["explicit", "inferred", "ambiguous"]},
          "evidence_segment_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^SEG-[0-9a-f]{32}$"}}
        }
      }
    }
  }
}
