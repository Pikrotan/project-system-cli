{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project System Rule Exceptions registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "const": "project-system-rule-exceptions-v1"
    },
    "exceptions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^EXC-[0-9]{8}-[0-9a-f]{8}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "state",
        "mode",
        "reason",
        "scope",
        "decision_id",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{0,}-[0-9]{3,}$"
        },
        "state": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "mode": {
          "enum": [
            "temporary",
            "permanent"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^DEC-[0-9]{8}-[0-9a-f]{8}$"
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_by": {
          "type": "string",
          "minLength": 1
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        },
        "revocation_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "temporary"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "expires_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "permanent"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "expires_at"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "revoked"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "revoked_by",
              "revoked_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "active"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "revoked_by"
                  ]
                },
                {
                  "required": [
                    "revoked_at"
                  ]
                },
                {
                  "required": [
                    "revocation_reason"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
