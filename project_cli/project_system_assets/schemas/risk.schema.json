{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "risk",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "domain",
    "status",
    "owner",
    "created_at",
    "source",
    "depends_on"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^RISK-[0-9]{8}-[A-Z2-9]{8}$"
    },
    "type": {
      "const": "risk"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "mitigated",
        "accepted",
        "closed"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "owner_decision",
            "team_decision",
            "design_change",
            "research",
            "user_feedback",
            "implementation",
            "external_requirement",
            "ai_proposal",
            "imported",
            "other"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "mitigation": {
      "type": [
        "string",
        "null"
      ]
    },
    "affects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [],
  "additionalProperties": true
}
