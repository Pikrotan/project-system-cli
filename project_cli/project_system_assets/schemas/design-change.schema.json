{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "design_change",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "domain",
    "status",
    "owner",
    "created_at",
    "source",
    "depends_on"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^DES-[0-9]{8}-[0-9a-f]{8}$"
    },
    "type": {
      "const": "design_change"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "new",
        "review",
        "approved",
        "synced",
        "rejected"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "owner_decision",
            "team_decision",
            "design_change",
            "research",
            "user_feedback",
            "implementation",
            "external_requirement",
            "ai_proposal",
            "imported",
            "other"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "change_type": {
      "enum": [
        "visual",
        "ux_change",
        "add",
        "remove",
        "proposal",
        "system"
      ]
    },
    "author": {
      "type": "string"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "logic_changed": {
      "type": "boolean"
    },
    "external_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "synced"
            ]
          }
        }
      },
      "then": {
        "required": [
          "approved_by",
          "approved_at"
        ]
      }
    }
  ],
  "additionalProperties": true
}
