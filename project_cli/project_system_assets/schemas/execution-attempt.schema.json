{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage A test-only execution checkpoint (not production approval or Evidence)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "project_id", "attempt_id", "state", "previous_sha256", "data", "checkpoint_sha256"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "profile": {"const": "project-system-execution-attempt-test-v1"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 128},
    "attempt_id": {"$ref": "#/$defs/attempt"},
    "state": {"enum": ["PREPARED", "DISPATCH_INTENT", "DISPOSITION"]},
    "previous_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "checkpoint_sha256": {"$ref": "#/$defs/sha"},
    "data": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "PREPARED"}}},
      "then": {"properties": {
        "previous_sha256": {"type": "null"},
        "data": {
          "type": "object", "additionalProperties": false,
          "required": ["contract", "contract_sha256"],
          "properties": {"contract": {"$ref": "#/$defs/contract"}, "contract_sha256": {"$ref": "#/$defs/sha"}}
        }
      }}
    },
    {
      "if": {"properties": {"state": {"const": "DISPATCH_INTENT"}}},
      "then": {"properties": {
        "previous_sha256": {"$ref": "#/$defs/sha"},
        "data": {
          "type": "object", "additionalProperties": false,
          "required": ["authorization"],
          "properties": {"authorization": {"$ref": "#/$defs/authorization"}}
        }
      }}
    },
    {
      "if": {"properties": {"state": {"const": "DISPOSITION"}}},
      "then": {"properties": {
        "previous_sha256": {"$ref": "#/$defs/sha"},
        "data": {
          "type": "object", "additionalProperties": false,
          "required": ["authorization", "outcome"],
          "properties": {"authorization": {"$ref": "#/$defs/authorization"}, "outcome": {"enum": ["abandoned", "unresolved"]}}
        }
      }}
    }
  ],
  "$defs": {
    "sha": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "attempt": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^ATTEMPT-[0-9a-f]{32}$"},
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "contract_sha256", "authorization_sha256"],
      "properties": {"kind": {"const": "test_only"}, "contract_sha256": {"$ref": "#/$defs/sha"}, "authorization_sha256": {"$ref": "#/$defs/sha"}}
    },
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "attempt_id", "contract_id", "contract_sha256", "pack_id", "pack_sha256", "pack_bytes", "instruction_sha256", "instruction_bytes", "adapter", "model", "options", "execution_mode", "allowed_destination", "limits", "retention", "scope"],
      "properties": {
        "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 128},
        "attempt_id": {"$ref": "#/$defs/attempt"},
        "contract_id": {"type": "string", "minLength": 37, "maxLength": 37, "pattern": "^XCON-[0-9a-f]{32}$"},
        "contract_sha256": {"$ref": "#/$defs/sha"},
        "pack_id": {"type": "string", "minLength": 38, "maxLength": 38, "pattern": "^XPACK-[0-9a-f]{32}$"},
        "pack_sha256": {"$ref": "#/$defs/sha"},
        "pack_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "instruction_sha256": {"$ref": "#/$defs/sha"},
        "instruction_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "adapter": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {"id": {"const": "deterministic-fake"}, "version": {"const": "1"}}
        },
        "model": {"const": "fake"},
        "options": {
          "type": "object", "additionalProperties": false, "required": ["scenario"],
          "properties": {"scenario": {"enum": ["success", "before_dispatch", "after_intent", "timeout", "unknown_delivery", "malformed_response", "interrupted_after_response"]}}
        },
        "execution_mode": {"const": "local_fake"},
        "allowed_destination": {"const": "none"},
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["max_pack_bytes", "max_response_bytes", "timeout_seconds"],
          "properties": {
            "max_pack_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
            "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30}
          }
        },
        "retention": {"const": "metadata_only"},
        "scope": {"const": "extraction_only"}
      }
    }
  }
}
