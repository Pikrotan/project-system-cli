{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "requirement",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "domain",
    "status",
    "owner",
    "created_at",
    "source",
    "depends_on"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{8}-[0-9a-f]{8}$"
    },
    "type": {
      "const": "requirement"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "active",
        "deprecated",
        "rejected"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "owner_decision",
            "team_decision",
            "design_change",
            "research",
            "user_feedback",
            "implementation",
            "external_requirement",
            "ai_proposal",
            "imported",
            "other"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "introduced_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "deprecated_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "deprecation_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "deprecated_by": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "deprecated_by"
            ]
          },
          {
            "properties": {
              "deprecation_reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "deprecation_reason"
            ]
          }
        ]
      }
    }
  ],
  "additionalProperties": true
}
