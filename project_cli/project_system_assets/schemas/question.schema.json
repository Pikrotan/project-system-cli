{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "question",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "domain",
    "status",
    "owner",
    "created_at",
    "source",
    "depends_on"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^Q-[0-9]{8}-[0-9a-f]{8}$"
    },
    "type": {
      "const": "question"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "needs_data",
        "ready_for_decision",
        "blocked",
        "resolved",
        "deferred"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "owner_decision",
            "team_decision",
            "design_change",
            "research",
            "user_feedback",
            "implementation",
            "external_requirement",
            "ai_proposal",
            "imported",
            "other"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_data": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_by": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resolved_by": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "resolved_by"
        ]
      }
    }
  ],
  "additionalProperties": true
}
