{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified Extraction Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "project_id", "contract_id", "representation_id", "segment_index_sha256", "allowed_kinds", "segments", "canonical_authority"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "profile": {"const": "project-system-verified-extraction-pack-v1"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "contract_id": {"type": "string", "pattern": "^XCON-[0-9a-f]{32}$"},
    "representation_id": {"type": "string", "pattern": "^REP-[0-9a-f]{32}$"},
    "segment_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["requirement", "decision", "risk", "question"]}
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "locator", "rendered_sha256", "rendered_bytes", "text"],
        "properties": {
          "segment_id": {"type": "string", "pattern": "^SEG-[0-9a-f]{32}$"},
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "line"],
            "properties": {
              "kind": {"const": "line"},
              "line": {"type": "integer", "minimum": 1}
            }
          },
          "rendered_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rendered_bytes": {"type": "integer", "minimum": 0, "maximum": 262144},
          "text": {"type": "string"}
        }
      }
    },
    "canonical_authority": {"const": false}
  }
}
