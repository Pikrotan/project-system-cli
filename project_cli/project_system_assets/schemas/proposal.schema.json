{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "project_id", "proposal_id", "run_id", "payload_sha256", "payload_bytes", "evidence_segment_ids", "canonical_authority", "human_review_required"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "profile": {"const": "project-system-proposal-v1"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "proposal_id": {"type": "string", "pattern": "^PROP-[0-9a-f]{32}$"},
    "run_id": {"type": "string", "pattern": "^XRUN-[0-9a-f]{32}$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
    "evidence_segment_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^SEG-[0-9a-f]{32}$"}},
    "canonical_authority": {"const": false},
    "human_review_required": {"const": true}
  }
}
